{
  "name": "order-management-api-testing",
  "version": "1.0.0",
  "description": "Enterprise Order Management – REST API & Integration Testing Framework (Playwright API, TypeScript, PostgreSQL, Postman/Newman, k6). Independent QA engineering portfolio project.",
  "private": true,
  "license": "MIT",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "env:up": "docker compose up -d --build --wait",
    "env:down": "docker compose down",
    "env:reset": "docker compose down -v && docker compose up -d --build --wait",
    "env:logs": "docker compose logs --tail=200 api",
    "setup": "tsx scripts/setup.ts",
    "seed": "tsx scripts/seed.ts",
    "health-check": "tsx scripts/health-check.ts",
    "cleanup": "tsx scripts/cleanup.ts",
    "test": "playwright test",
    "test:smoke": "playwright test --grep @smoke",
    "test:api": "playwright test --grep @api",
    "test:auth": "playwright test --grep \"@authentication|@authorization\"",
    "test:integration": "playwright test --grep @integration",
    "test:database": "playwright test --grep @database",
    "test:contract": "playwright test --grep @contract",
    "test:security": "playwright test --grep @security",
    "test:negative": "playwright test --grep @negative",
    "test:concurrency": "playwright test --grep @concurrency",
    "test:regression": "playwright test --grep @regression",
    "test:known-defects": "playwright test --grep @known-defect",
    "test:postman": "tsx scripts/run-newman.ts",
    "test:performance": "tsx scripts/run-k6.ts smoke",
    "test:performance:load": "tsx scripts/run-k6.ts load",
    "test:performance:stress": "tsx scripts/run-k6.ts stress",
    "test:performance:spike": "tsx scripts/run-k6.ts spike",
    "report": "tsx scripts/report.ts",
    "report:playwright": "playwright show-report reports/playwright-html",
    "report:summary": "tsx scripts/summarize-results.ts",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "postman:build": "tsx postman/build-collection.ts",
    "repro:contention": "tsx scripts/repro-contention.ts",
    "evidence": "tsx scripts/capture-evidence.ts",
    "docs:traceability": "tsx scripts/traceability.ts"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@faker-js/faker": "^10.6.0",
    "@playwright/test": "^1.65.1",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/newman": "^5.3.6",
    "@types/node": "^22.19.0",
    "@types/pg": "^8.23.1",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "allure": "^3.33.0",
    "allure-playwright": "^3.15.0",
    "dotenv": "^17.2.3",
    "eslint": "^10.15.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-playwright": "^2.12.2",
    "globals": "^17.14.0",
    "jsonwebtoken": "^9.0.3",
    "newman": "^6.2.3",
    "newman-reporter-htmlextra": "^1.23.1",
    "pg": "^8.23.1",
    "prettier": "^3.10.1",
    "tsx": "^4.23.15",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.74.0",
    "zod": "^4.6.7"
  }
}
