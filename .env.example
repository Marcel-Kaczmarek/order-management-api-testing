# Safe defaults for the LOCAL Docker Compose environment only.
# Copy to .env to override. Never commit a real .env file.

# Target environment label (local | ci). Remote targets are deliberately unsupported.
TEST_ENV=local

# Application under test
API_BASE_URL=http://localhost:3000
API_PORT=3000

# JWT secret configured in the local AUT container. The framework needs it only to
# craft expired/tampered tokens for negative authentication tests.
JWT_SECRET=local-qa-jwt-secret-not-for-production
JWT_EXPIRES_IN=1d

# Seed accounts created by the AUT's own seed script (application-under-test/prisma/seed.ts)
ADMIN_EMAIL=admin@orderflow.dev
ADMIN_PASSWORD=Admin123!
SEED_CUSTOMER_EMAIL=customer@orderflow.dev
SEED_CUSTOMER_PASSWORD=Customer123!

# PostgreSQL (owner credentials are used only by the AUT container)
POSTGRES_USER=orderflow
POSTGRES_PASSWORD=orderflow
POSTGRES_DB=orderflow
DB_HOST=localhost
DB_PORT=55432

# Read-only role used by the QA framework for database validation
DB_READONLY_USER=qa_readonly
DB_READONLY_PASSWORD=qa_readonly

# Test execution
TEST_WORKERS=4
TEST_RETRIES=0
TEST_TIMEOUT_MS=30000
# Fixed seed => reproducible Faker data (combined with worker index + test id for uniqueness)
FAKER_SEED=20261124
# Logs sanitized request/response diagnostics (debug | info | warn | error)
LOG_LEVEL=info
